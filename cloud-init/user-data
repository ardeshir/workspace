#cloud-config
#
# ============================================================================
#  THIS FILE SETS UP YOUR VM'S USER ACCOUNT ON FIRST BOOT.
#
#  There are exactly TWO things you must change. They are marked EDIT 1 and
#  EDIT 2 below. Everything else can stay as it is.
#
#  RULES (these matter, YAML is picky):
#    * Use SPACES to indent. Never press the Tab key in this file.
#    * Keep the '- ' and the spaces in front of it exactly as they are.
#    * The first line must stay exactly: #cloud-config
#
#  After editing, save the file and run:  ./cloud-init/make-seed.sh
# ============================================================================

hostname: devvm
manage_etc_hosts: true

users:
  - name: dev
    gecos: Developer
    groups: [sudo]
    shell: /bin/bash
    # Lets you use 'sudo' without retyping a password.
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    ssh_authorized_keys:

      # ---------------------------------------------------------------------
      # EDIT 1 — YOUR SSH KEY
      #
      # On your Mac, in Terminal, run:
      #     cat ~/.ssh/id_ed25519.pub
      #
      # If that says "No such file or directory", first run:
      #     ssh-keygen -t ed25519 -C "dev vm"
      # and press Return three times to accept the defaults, then run the
      # 'cat' command again.
      #
      # Copy the ENTIRE line it prints. It looks like this, all on one line:
      #
      #     ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA...long...string you@yourmac
      #
      # Then select the whole placeholder below -- the words
      # PASTE_YOUR_PUBLIC_KEY_LINE_HERE -- and paste your line over the top
      # of it. Keep the '      - ' in front. The result should read:
      #
      #       - ssh-ed25519 AAAAC3Nza... you@yourmac
      #
      # NOT '- ssh-ed25519 ssh-ed25519 AAAA...'. If you see 'ssh-ed25519'
      # twice, delete one of them -- a doubled-up key is rejected and you
      # will not be able to log in.
      # ---------------------------------------------------------------------
      - PASTE_YOUR_PUBLIC_KEY_LINE_HERE

# ---------------------------------------------------------------------------
# EDIT 2 — YOUR PASSWORD
#
# You will normally log in with your SSH key. This password is your backup:
# it gets you in at the VM's black console window, and over SSH too, so a
# mistyped key can never lock you out completely.
#
# Change 'changeme' below to a password you will remember. Keep the quotes.
# ---------------------------------------------------------------------------
chpasswd:
  expire: false
  users:
    - name: dev
      password: "changeme"
      type: text

# Allow password logins over SSH as a fallback.
#
# This is safe here: the VM has no public address. It sits on a private
# network inside your Mac and is reachable only from your own machine.
#
# Once your SSH key is working and you're confident, you can set this to
# false and rebuild the seed for a slightly tighter setup.
ssh_pwauth: true

# Freshen the package list so the first 'apt install' works.
package_update: true

packages:
  - curl
  - git
  - ca-certificates

write_files:
  - path: /etc/motd
    content: |

      Welcome to your dev VM.

      Next step, if you haven't run it yet:

          git clone https://github.com/ardeshir/workspace.git ~/vm && cd ~/vm && ./provision.sh

      Already provisioned? Check everything is healthy with:

          ~/vm/verify.sh

runcmd:
  - [ systemctl, enable, --now, ssh ]

final_message: "VM ready after $UPTIME seconds. Log in with: ssh dev@<ip>"
